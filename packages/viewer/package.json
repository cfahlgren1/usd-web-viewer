{
  "name": "usd-web-viewer",
  "version": "0.1.0",
  "description": "OpenUSD viewer for the web: pure-Rust USD composition (openusd) in WASM, rendered with three.js",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./element": {
      "types": "./src/element.d.ts",
      "default": "./src/element.js"
    },
    "./wasm/usd_wasm_bg.wasm": "./wasm/usd_wasm_bg.wasm"
  },
  "files": [
    "src",
    "wasm/usd_wasm.js",
    "wasm/usd_wasm_bg.wasm"
  ],
  "sideEffects": [
    "./src/element.js"
  ],
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "types": "./src/index.d.ts"
}
