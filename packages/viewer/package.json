{
  "name": "usd-web-viewer",
  "version": "0.1.0",
  "description": "OpenUSD viewer for the web: pure-Rust USD composition (openusd) in WASM, rendered with three.js",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./hub": {
      "types": "./dist/hub.d.ts",
      "default": "./dist/hub.js"
    },
    "./worker": "./dist/worker.js",
    "./wasm/usd_wasm_bg.wasm": "./wasm/usd_wasm_bg.wasm"
  },
  "files": [
    "dist",
    "!dist/{hub-prefetch,load-core,materials,meta,worker}.d.ts",
    "wasm/usd_wasm.js",
    "wasm/usd_wasm_bg.wasm",
    "THIRD_PARTY_LICENSES"
  ],
  "sideEffects": [
    "./dist/element.js"
  ],
  "peerDependencies": {
    "three": ">=0.162.0 <0.187.0",
    "@types/three": ">=0.162.0 <0.187.0"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p .",
    "prepack": "bash ../../scripts/build-wasm.sh && npm run build"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
