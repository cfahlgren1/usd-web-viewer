{
  "name": "usd-web-viewer",
  "version": "0.1.0",
  "description": "OpenUSD viewer for the web: pure-Rust USD composition (openusd) in WASM, rendered with three.js",
  "license": "MIT",
  "type": "module",
  "tshy": {
    "dialects": [
      "esm"
    ],
    "exports": {
      ".": "./src/index.ts",
      "./worker": "./src/worker.ts",
      "./wasm/usd_wasm_bg.wasm": "./dist/wasm/usd_wasm_bg.wasm",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "!dist/esm/{hub-prefetch,load-core,materials,meta}.d.ts",
    "THIRD_PARTY_LICENSES"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tshy && npm pkg set types=./dist/esm/index.d.ts && if [ -f wasm/usd_wasm_bg.wasm ]; then mkdir -p dist/wasm && cp wasm/usd_wasm.js wasm/usd_wasm_bg.wasm dist/wasm/; fi",
    "build:wasm": "bash ../../scripts/build-wasm.sh",
    "test": "vitest run",
    "test:browser": "node ../../scripts/api-test.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint --quiet --fix --ext .cjs,.ts .",
    "lint:check": "eslint --ext .cjs,.ts .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepack": "npm run build:wasm && npm run build"
  },
  "peerDependencies": {
    "@types/three": ">=0.162.0 <0.187.0",
    "three": ">=0.162.0 <0.187.0"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/esm/worker.d.ts",
        "default": "./dist/esm/worker.js"
      }
    },
    "./wasm/usd_wasm_bg.wasm": "./dist/wasm/usd_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts"
}
