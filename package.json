{
  "name": "usd-web-viewer-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "npm --prefix packages/viewer run build:wasm",
    "build": "npm --prefix packages/viewer run build",
    "test": "npm --prefix packages/viewer run test",
    "test:browser": "npm --prefix packages/viewer run test:browser",
    "check": "npm --prefix packages/viewer run check",
    "licenses": "node scripts/third-party-licenses.mjs",
    "lint": "oxlint scripts examples && npm --prefix packages/viewer run lint:check",
    "format": "oxfmt packages scripts examples",
    "format:check": "oxfmt --check packages scripts examples"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "binaryen": "^132.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "1.64.0",
    "three": "^0.186.1",
    "tshy": "^3.3.2",
    "typescript": "~5.9.3",
    "vitest": "0.34.6"
  },
  "engines": {
    "node": ">=22"
  }
