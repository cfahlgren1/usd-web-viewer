{
  "name": "usd-web-viewer-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "bash scripts/build-wasm.sh",
    "serve": "node scripts/serve.mjs",
    "test": "node --test 'packages/viewer/test/*.test.mjs'",
    "test:browser": "node scripts/api-test.mjs",
    "check:types": "tsc --noEmit --strict --exactOptionalPropertyTypes --skipLibCheck --module nodenext --target es2022 --lib es2022,dom packages/viewer/test/types.ts",
    "licenses": "node scripts/third-party-licenses.mjs",
    "lint": "oxlint packages scripts examples",
    "format": "oxfmt packages scripts examples",
    "format:check": "oxfmt --check packages scripts examples"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "binaryen": "^132.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "1.64.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
